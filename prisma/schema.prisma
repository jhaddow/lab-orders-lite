generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLINICIAN
  ADMIN
}

/// A clinician or admin user. In this take-home, the "session" is a signed
/// cookie carrying the user id (no passwords) — see `lib/auth.ts`. Real
/// production would swap NextAuth/Lucia in behind `getCurrentUser()` with
/// no call-site changes.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())

  createdOrders Order[]    @relation("OrderCreatedBy")
  auditEntries  AuditLog[]
}

/// Append-only audit trail. Every action that mutates a tracked entity
/// writes one row inside the same transaction as the mutation. The metadata
/// JSON carries action-specific detail (status from/to, cancellation reason,
/// etc.) so the schema doesn't grow a column per action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  email       String?
  phone       String?
  createdAt   DateTime @default(now())

  orders Order[]

  @@index([lastName, firstName])
}

model LabTest {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String   @unique
  turnaroundDays Int
  createdAt      DateTime @default(now())

  prices     Price[]
  orderItems OrderItem[]
}

/// Append-only price history per lab test. The newest row (by createdAt) is
/// the catalog's current price; orders reference the specific Price record
/// that was current when they were created, so historical totals never drift.
model Price {
  id         String   @id @default(cuid())
  labTestId  String
  priceCents Int
  currency   String   @default("USD")
  createdAt  DateTime @default(now())

  labTest    LabTest     @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([labTestId, createdAt(sort: Desc)])
}

enum OrderStatus {
  PENDING
}

model Order {
  id                 String      @id @default(cuid())
  patientId          String
  createdByUserId    String
  status             OrderStatus @default(PENDING)
  totalCents         Int
  currency           String      @default("USD")
  estimatedReadyDate DateTime    @db.Date
  createdAt          DateTime    @default(now())

  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  createdBy User        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items     OrderItem[]

  @@index([patientId])
  @@index([createdByUserId])
  @@index([createdAt])
}

model OrderItem {
  id                    String @id @default(cuid())
  orderId               String
  labTestId             String
  priceId               String
  turnaroundDaysAtOrder Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labTest LabTest @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  price   Price   @relation(fields: [priceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([priceId])
}
